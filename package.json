{
  "name": "base-structure",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 5050",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,vue,json,css}\"",
    "validate": "yarn typecheck && yarn lint && yarn build",
    "prepare": "husky"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.92.1",
    "@tanstack/vue-query-devtools": "^5.91.0",
    "@vee-validate/i18n": "^4.15.1",
    "@vee-validate/rules": "^4.15.1",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^10.9.0",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^2.2.6",
    "reka-ui": "^2.9.1",
    "tailwind-merge": "^3.5.0",
    "vee-validate": "^4.13.2",
    "vue": "^3.5.12",
    "vue-i18n": "^9.10.1",
    "vue-router": "^4.3.0",
    "vue-sonner": "^2.0.9",
    "vuedraggable": "4.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@intlify/unplugin-vue-i18n": "^2.0.0",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.13.13",
    "@vitejs/plugin-vue": "^5.0.4",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.0.3",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.28.0",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^5.4.14",
    "vue-tsc": "^2.2.8"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@1.22.18"
}
